{
  "name": "packworks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A clean incremental game about opening card packs, improving a collection, and selling duplicates.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-static.mjs",
    "build:portal": "node scripts/build-portal.mjs",
    "build:test": "node scripts/build-test.mjs",
    "deploy:test": "node scripts/deploy-test.mjs",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "art:pixellab": "node scripts/generate-pixellab-art.mjs",
    "art:audit": "node scripts/audit-pixellab-art.mjs",
    "simulate": "node scripts/simulate-balance.mjs"
  },
  "dependencies": {
    "augmented-ui": "^2.0.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
